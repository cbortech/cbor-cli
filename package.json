{
  "name": "@cbortech/cbor-cli",
  "version": "0.27.0",
  "description": "Command-line tool to convert between CBOR binary data, CDN (Concise Diagnostic Notation) text, and annotated hex dumps",
  "keywords": [
    "cbor",
    "cdn",
    "cddl",
    "cddl-validation",
    "cbor-edn",
    "diagnostic-notation",
    "cli",
    "binary",
    "serialization"
  ],
  "homepage": "https://cbor.tech/cbor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbortech/cbor-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cbortech/cbor-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Yasuhiro Kudo <ykudo@ykudo.org>",
  "type": "module",
  "bin": {
    "cbor": "dist/cbor.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cbortech/cbor": "^0.27.2",
    "@cbortech/hash-extension": "^0.27.0",
    "@cbortech/set-map-extensions": "^0.27.0",
    "@cbortech/uuid-extension": "^0.27.0",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
